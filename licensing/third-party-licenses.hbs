<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Third-party licences</title>
</head>
<body>
  <h1>Third-party licences</h1>
  <p>The binary links the crates below statically. Each licence text follows in full.</p>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  {{#each licenses}}
  <h2 id="{{id}}">{{name}}</h2>
  <ul>
    {{#each used_by}}
    <li>{{crate.name}} {{crate.version}}</li>
    {{/each}}
  </ul>
  <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
